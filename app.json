{
  "expo": {
    "name": "طريقي - كابتن",
    "slug": "tariq-captain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#CC1020",
      "androidMode": "collapse",
      "androidCollapsedTitle": "طريقي - كابتن"
    },
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0002"
    },
    "assetBundlePatterns": ["**/*"],
    "scheme": "tariq-captain",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tariq.captain",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لعرضه للركاب وتحديث موقعك على الخريطة",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "نحتاج موقعك في الخلفية لتحديثه للركاب أثناء الرحلة",
        "NSFaceIDUsageDescription": "للدخول السريع إلى التطبيق"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0002"
      },
      "package": "com.tariq.captain",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDZeUFnQWV1zfeHBsExMRZ5F5zFyU1oj5o"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يحتاج التطبيق إلى موقعك لمشاركته مع الركاب.",
          "locationAlwaysPermission": "يحتاج التطبيق إلى موقعك في الخلفية.",
          "locationWhenInUsePermission": "يحتاج التطبيق إلى موقعك أثناء الاستخدام.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#CC1020",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9c456ea5-c9e6-457a-abbb-23338b32c342"
      }
    }
  }
}
