{
  "expo": {
    "name": "طريقي",
    "slug": "tariqy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tariqyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tariqy.app"
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDZeUFnQWV1zfeHBsExMRZ5F5zFyU1oj5o"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.tariqy.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم التطبيق Face ID لتسجيل الدخول بشكل آمن وسريع"
        }
      ],
      [
        "expo-secure-store"
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#CC1020",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق للوصول لمكتبة الصور لتحديث صورة ملفك الشخصي",
          "cameraPermission": "يحتاج التطبيق للكاميرا لالتقاط صورة ملفك الشخصي"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
